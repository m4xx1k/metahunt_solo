# The lab's own database handle. Deliberately NOT called DATABASE_URL: every
# other command in this repo reads DATABASE_URL from whichever `.env` is in the
# working directory, so a lab `.env` using that name retargets them all (MET-133).
#
# Points at a local restore of a prod dump. pipeline/psql.sh refuses any URL
# whose database name is not `metahunt_lab`.
LAB_DATABASE_URL=postgres://metahunt:metahunt@localhost:54322/metahunt_lab
